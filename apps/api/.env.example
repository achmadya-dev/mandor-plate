NODE_ENV=development
APP_PORT=3001
APP_NAME="Mandor Plate API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001

DATABASE_TYPE=postgres
DATABASE_HOST=your-postgres-host
DATABASE_PORT=5432
DATABASE_USERNAME=your-postgres-user
DATABASE_PASSWORD=your-postgres-password
DATABASE_NAME=your-postgres-database
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_IGNORE_TLS=false
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_DEFAULT_EMAIL=your-gmail-address@gmail.com
MAIL_DEFAULT_NAME=Mandor Plate

AUTH_JWT_SECRET=replace-with-strong-random-secret-min-32-chars
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=replace-with-strong-random-refresh-secret-min-32
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=replace-with-strong-random-forgot-secret-min-32
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=replace-with-strong-random-confirm-secret-min-32
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
